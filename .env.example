# BTC Wallet Plugin — Environment Variables

# Arkade server URL
# Mutinynet (testnet): https://mutinynet.arkade.sh
# Local regtest:       http://localhost:7070
ARKADE_SERVER=https://mutinynet.arkade.sh

# Network name: mutinynet or regtest
ARKADE_NETWORK=mutinynet

# Block explorer URL for transaction links
ARKADE_EXPLORER=https://explorer.mutinynet.arkade.sh

# Hex-encoded private key (optional)
# If not set, create_wallet generates an ephemeral keypair
# WALLET_PRIVATE_KEY=your-hex-encoded-private-key
