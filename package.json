{
  "name": "btc-wallet-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable BTC wallet MCP server for AI agents — wraps Arkade SDK for wallet, escrow, and signing operations",
  "scripts": {
    "start": "node --loader tsx src/server.ts",
    "dev": "npx tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "fund": "npx tsx scripts/fund.ts",
    "keygen": "npx tsx scripts/keygen.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.3.12",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@scure/base": "^1.1.0",
    "eventsource": "^4.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
